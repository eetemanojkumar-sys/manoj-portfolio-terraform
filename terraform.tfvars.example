aws_region    = "ap-south-1"
project_name  = "manoj-portfolio"
environment   = "portfolio"
instance_type = "t3.micro"

# SSM is used for deployment. SSH is disabled by default.
enable_ssh = false
# If enabling SSH, set your trusted current public IP as x.x.x.x/32 and the public key path.
ssh_allowed_cidr = null
public_key_path  = null

root_volume_size = 10
